        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="createButton">
       <property name="text">
        <string>Create Part</string>
       </property>
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="default">
        <bool>true</bool>
       </property>
