       <item>
        <widget class="QGroupBox" name="datasheetGroup">
         <property name="title">
          <string>Datasheet</string>
         </property>
         <layout class="QVBoxLayout" name="datasheetLayout">
          <item>
           <widget class="QLabel" name="datasheetLabel">
            <property name="text">
             <string>No datasheet attached yet.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="datasheetButtonLayout">
            <item>
             <widget class="QPushButton" name="openDatasheetButton">
              <property name="text">
               <string>Open</string>
              </property>
              <property name="toolTip">
               <string>Open the stored datasheet in the system's default viewer.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="attachDatasheetButton">
              <property name="text">
               <string>Attach file…</string>
              </property>
              <property name="toolTip">
               <string>Copy a file from this computer into the database's file store.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="downloadDatasheetButton">
              <property name="text">
               <string>Download…</string>
              </property>
              <property name="toolTip">
               <string>Fetch the datasheet from a URL. Mouser leaves this empty for most parts.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="removeDatasheetButton">
              <property name="text">
               <string>Remove</string>
              </property>
              <property name="toolTip">
               <string>Detach the datasheet from this part.</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="datasheetSpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="imageGroup">
         <property name="title">
          <string>Image</string>
         </property>
         <property name="toolTip">
          <string>A photo of the part, shown as a thumbnail in the first column of the parts table so the component is recognisable at a glance. It is stored as an ordinary attachment (role &quot;image&quot;), like the datasheet.</string>
         </property>
         <layout class="QHBoxLayout" name="imageLayout">
          <item>
           <widget class="QLabel" name="imagePreviewLabel">
            <property name="minimumSize">
             <size>
              <width>96</width>
              <height>96</height>
             </size>
            </property>
            <property name="maximumSize">
             <size>
              <width>96</width>
              <height>96</height>
             </size>
            </property>
            <property name="frameShape">
             <enum>QFrame::StyledPanel</enum>
            </property>
            <property name="alignment">
             <set>Qt::AlignCenter</set>
            </property>
            <property name="styleSheet">
             <string notr="true">color: #8a929c; background-color: #f0f3f7;</string>
            </property>
            <property name="text">
             <string>none</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QVBoxLayout" name="imageButtonLayout">
            <item>
             <widget class="QLabel" name="imageStateLabel">
              <property name="text">
               <string>No image attached yet.</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="imageButtonRow">
              <item>
               <widget class="QPushButton" name="attachImageButton">
                <property name="text">
                 <string>Attach file…</string>
                </property>
                <property name="toolTip">
                 <string>Copy a picture from this computer into the database's file store.</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="downloadImageButton">
                <property name="text">
                 <string>Download…</string>
                </property>
                <property name="toolTip">
                 <string>Fetch a picture from a URL — for example the product photo on the part's Mouser page.</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="removeImageButton">
                <property name="text">
                 <string>Remove</string>
                </property>
                <property name="toolTip">
                 <string>Detach the image from this part.</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="imageSpacer">
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>40</width>
                  <height>20</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="kicadGroup">
         <property name="title">
          <string>KiCad</string>
         </property>
         <property name="toolTip">
          <string>This part's own symbol and footprint. They are what &quot;Generate Libraries&quot; puts into the shared KiCad library, and an edit you make in KiCad is written back here the next time you regenerate — so the two copies stay identical.</string>
         </property>
         <layout class="QVBoxLayout" name="kicadLayout">
          <item>
           <layout class="QHBoxLayout" name="kicadImportRow">
            <item>
             <widget class="QPushButton" name="importEcadButton">
              <property name="text">
               <string>Import vendor ZIP…</string>
              </property>
              <property name="toolTip">
               <string>Reads a library download such as &quot;LIB_74HC4051PW-Q100,11.zip&quot; from Component Search Engine, Ultra Librarian or SnapEDA, and takes the KiCad symbol, the footprint and the 3D model out of it. Everything for the other twenty CAD tools in the archive is ignored. The files are copied into this database, so the ZIP can be deleted afterwards.</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="kicadImportSpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QFormLayout" name="kicadFormLayout">
            <item row="0" column="0">
             <widget class="QLabel" name="kicadSymbolCaption">
              <property name="text">
               <string>Symbol</string>
              </property>
              <property name="toolTip">
               <string>A .kicad_sym file holding this part's schematic symbol. Without one the generated library uses a plain box or a generic resistor/capacitor outline, which works but has no real pinout.</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <layout class="QHBoxLayout" name="kicadSymbolRow">
              <item>
               <widget class="QLabel" name="kicadSymbolLabel">
                <property name="text">
                 <string>Generated from the type template.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
                  <horstretch>1</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="attachSymbolButton">
                <property name="text">
                 <string>Attach…</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="removeSymbolButton">
                <property name="text">
                 <string>Remove</string>
                </property>
                <property name="toolTip">
                 <string>Puts this part back on the generic generated symbol.</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="kicadFootprintCaption">
              <property name="text">
               <string>Footprint</string>
              </property>
              <property name="toolTip">
               <string>A .kicad_mod file — the copper pads and courtyard. KiCad keeps footprints as one file each inside a .pretty folder, which is how they are written out.</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <layout class="QHBoxLayout" name="kicadFootprintRow">
              <item>
               <widget class="QLabel" name="kicadFootprintLabel">
                <property name="text">
                 <string>None.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
                  <horstretch>1</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="attachFootprintButton">
                <property name="text">
                 <string>Attach…</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="removeFootprintButton">
                <property name="text">
                 <string>Remove</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="kicadModelCaption">
              <property name="text">
               <string>3D model</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QLabel" name="kicadModelLabel">
              <property name="text">
               <string>None.</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="stockHistoryGroup">
         <property name="title">
          <string>Stock history</string>
         </property>
         <layout class="QVBoxLayout" name="stockHistoryLayout">
          <item>
           <widget class="QTableWidget" name="historyTable">
