      <property name="geometry">
       <rect>
        <x>0</x>
        <y>0</y>
        <width>580</width>
        <height>460</height>
       </rect>
      </property>
      <layout class="QVBoxLayout" name="scrollLayout">
       <item>
        <widget class="QGroupBox" name="identityGroup">
         <property name="title">
          <string>Identity</string>
         </property>
         <layout class="QFormLayout" name="identityLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="nameLabel">
            <property name="text">
             <string>Name</string>
            </property>
            <property name="toolTip">
             <string>What you want to see in the parts table. Freely chosen — e.g. &quot;4k7 0603 1%&quot; or &quot;LM358 dual op-amp&quot;.</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="nameEdit"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="manufacturerLabel">
            <property name="text">
             <string>Manufacturer</string>
            </property>
            <property name="toolTip">
             <string>Who makes the part — e.g. Murata, Texas Instruments, Yageo.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="manufacturerEdit"/>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="mpnLabel">
            <property name="text">
             <string>MPN</string>
            </property>
            <property name="toolTip">
             <string>Manufacturer Part Number — the maker's own order code, e.g. &quot;LM358DR&quot; or &quot;GRM188R71H104KA93D&quot;. Ordering does not use this; that is the Mouser P/N below.</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="mpnEdit">
            <property name="toolTip">
             <string>The manufacturer's own part number. Mouser will not accept this when ordering — that is the Mouser P/N below.</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="mouserLabel">
            <property name="text">
             <string>Mouser P/N</string>
            </property>
            <property name="toolTip">
             <string>Mouser's own article number, e.g. &quot;595-LM358DR&quot;. This is what the cart orders by — the MPN will not work. Filled in automatically when the part came from a Mouser search.</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <layout class="QHBoxLayout" name="mouserRow">
            <item>
             <widget class="QLineEdit" name="mouserEdit">
              <property name="placeholderText">
               <string>e.g. 595-DRV5053CAQLPGM — required to order this part</string>
              </property>
              <property name="toolTip">
               <string>Mouser's own article number. This is what the cart needs; the MPN above will not work. Filled in automatically for parts created from a Mouser search.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="openMouserButton">
              <property name="text">
               <string>Open on Mouser</string>
              </property>
              <property name="enabled">
               <bool>false</bool>
              </property>
              <property name="toolTip">
               <string>Opens this part's page on mouser.com in your browser.</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="packageLabel">
            <property name="text">
             <string>Package</string>
            </property>
            <property name="toolTip">
             <string>The physical housing the part comes in — its body shape and pin arrangement, which is what decides the PCB footprint.

Not the same as THT vs SMD, though the name usually implies it:
• SMD examples: 0603, 0805, SOT-23, SOIC-8, QFN-32, TQFP-44
• THT examples: DIP-8, TO-220, TO-92, radial 5 mm, axial 0207
• Mechanical parts: M3x10, M2.5 standoff

Mouser fills this in from its &quot;Package / Case&quot; column.</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QLineEdit" name="packageEdit">
            <property name="placeholderText">
             <string>e.g. 0603, SOIC-8, TO-220, DIP-8, M3x10</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="descriptionLabel">
            <property name="text">
             <string>Description</string>
            </property>
            <property name="toolTip">
             <string>Free-text notes. Mouser's own product description lands here when the part came from a search.</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QPlainTextEdit" name="descriptionEdit">
            <property name="maximumSize">
             <size>
              <width>16777215</width>
              <height>80</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="stockLabel">
            <property name="text">
             <string>Stock</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QSpinBox" name="stockSpin">
            <property name="minimum">
             <number>-100000000</number>
            </property>
            <property name="maximum">
             <number>100000000</number>
            </property>
            <property name="toolTip">
             <string>The counted quantity. Changing it records a manual adjustment in the history below.</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0">
           <widget class="QLabel" name="stockMinLabel">
            <property name="text">
             <string>Reorder threshold</string>
            </property>
           </widget>
          </item>
          <item row="7" column="1">
           <widget class="QSpinBox" name="stockMinSpin">
            <property name="maximum">
             <number>100000000</number>
            </property>
           </widget>
          </item>
          <item row="8" column="0">
           <widget class="QLabel" name="searchKeywordsLabel">
            <property name="text">
             <string>Search words</string>
            </property>
           </widget>
          </item>
          <item row="8" column="1">
           <widget class="QPlainTextEdit" name="searchKeywordsEdit">
            <property name="maximumSize">
             <size>
              <width>16777215</width>
              <height>60</height>
             </size>
            </property>
           </widget>
          </item>
          <item row="9" column="1">
           <widget class="QLabel" name="inheritedKeywordsLabel">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="text">
             <string notr="true"/>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
